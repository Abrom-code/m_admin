# MatricMate Admin — environment configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and is NOT bundled as a Flutter asset, unlike the
# parent matricmate app which ships its .env inside the APK.

# Supabase project URL, e.g. https://gcscoitnhdrqsibkxrit.supabase.co
SUPABASE_URL=

# Supabase anon/publishable key. This grants no admin access on its own —
# privileged calls are authorised by the JWT from the admin-auth function.
SUPABASE_API_KEY=

# Shared secret for the x-webhook-secret header on send-push (Phase 2a).
# Must match the PUSH_WEBHOOK_SECRET set via `supabase secrets set`.
PUSH_WEBHOOK_SECRET=

# Edge function base URL, e.g.
# https://gcscoitnhdrqsibkxrit.supabase.co/functions/v1
ADMIN_FUNCTIONS_BASE_URL=

# ── Mock login credentials (dev / staging only) ───────────────────────────
# Used when Firebase auth is replaced by local credential validation.
# Remove or leave blank to fall back to the hardcoded defaults in AppEnv.
MOCK_ADMIN_EMAIL=
MOCK_ADMIN_PASSWORD=
